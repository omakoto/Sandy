#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -euo pipefail

# Check if bwrap is installed
if ! command -v bwrap >/dev/null 2>&1; then
  echo "Error: bubblewrap (bwrap) is not installed." >&2
  exit 1
fi

# Ensure HOME is set
if [ -z "${HOME:-}" ]; then
  echo "Error: HOME environment variable is not set." >&2
  exit 1
fi

# Parse options for sandy itself
usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] [--] [COMMAND [ARGS...]]

Create a lightweight sandbox hiding ~/.ssh and ~/.config.

Options:
  -h, --help  Show this help message.

If COMMAND is specified, it is executed inside the sandbox.
Otherwise, an interactive bash shell is launched.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      break
      ;;
    *)
      break
      ;;
  esac
done

# Regex for subdirectories and files inside ~/.config to whitelist (keep in sandbox)
DEFAULT_CONFIG_WHITELIST_REGEX="^("
DEFAULT_CONFIG_WHITELIST_REGEX+="gtk.*|git|nvim|gh|dconf|meld"
DEFAULT_CONFIG_WHITELIST_REGEX+=")$"
CONFIG_WHITELIST_REGEX="${CONFIG_WHITELIST_REGEX:-$DEFAULT_CONFIG_WHITELIST_REGEX}"

# Build bubblewrap arguments
bwrap_args=(
  --bind / /
  --dev-bind /dev /dev
  --bind "$HOME" "$HOME"
)

# Hide .ssh if it exists by mounting a tmpfs over it
if [ -d "$HOME/.ssh" ]; then
  bwrap_args+=(--tmpfs "$HOME/.ssh")
fi

# Populate whitelisted entries from ~/.config
if [ -d "$HOME/.config" ]; then
  # Mount a tmpfs over ~/.config to hide non-whitelisted entries
  bwrap_args+=(--tmpfs "$HOME/.config")

  # Use nullglob/dotglob to safely iterate over all files, including hidden ones
  shopt -s nullglob dotglob

  for entry in "$HOME/.config"/*; do
    name="${entry##*/}"

    # Skip current and parent directories (just in case)
    if [ "$name" = "." ] || [ "$name" = ".." ]; then
      continue
    fi

    # Bind mount only whitelisted subdirectories and files matching the regex
    if [[ "$name" =~ $CONFIG_WHITELIST_REGEX ]]; then
      dest="$HOME/.config/$name"
      bwrap_args+=(--bind "$entry" "$dest")
    fi
  done
fi

# Create a temporary directory for sandbox wrappers
sandy_temp_bin_dir=$(mktemp -d /tmp/sandy-bin.XXXXXX)

# Register cleanup on exit
cleanup() {
  rm -rf "$sandy_temp_bin_dir"
}
trap cleanup EXIT

# Write wrappers for VS Code commands to fail explicitly and protect sandbox security
for cmd in code code-insiders codium; do
  if command -v "$cmd" >/dev/null 2>&1; then
    cat << EOF > "$sandy_temp_bin_dir/$cmd"
#!/usr/bin/env bash
echo "Error: Running $cmd inside the sandy sandbox is disabled to prevent running it without its default sandbox protection." >&2
exit 1
EOF
    chmod +x "$sandy_temp_bin_dir/$cmd"
  fi
done

# Export PATH for wrapper scripts
export PATH="$sandy_temp_bin_dir:$PATH"

# Run bubblewrap
if [ $# -eq 0 ]; then
  bwrap "${bwrap_args[@]}" /bin/bash
elif [[ "$1" == -* ]]; then
  bwrap "${bwrap_args[@]}" /bin/bash "$@"
else
  bwrap "${bwrap_args[@]}" "$@"
fi
