#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -euo pipefail

# Check if bwrap is installed
if ! command -v bwrap >/dev/null 2>&1; then
  echo "Error: bubblewrap (bwrap) is not installed." >&2
  exit 1
fi

# Ensure HOME is set
if [ -z "${HOME:-}" ]; then
  echo "Error: HOME environment variable is not set." >&2
  exit 1
fi

# Parse options for sandy itself
ENABLE_GIT_WRAPPER=true

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] [--] [COMMAND [ARGS...]]

Create a lightweight sandbox hiding ~/.ssh and ~/.config.

Options:
  -N          Disable the git wrapper (which prevents VFS-isolated paths from appearing as deleted in git status).
  -h, --help  Show this help message.

If COMMAND is specified, it is executed inside the sandbox.
Otherwise, an interactive bash shell is launched.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -N)
      ENABLE_GIT_WRAPPER=false
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      break
      ;;
    *)
      break
      ;;
  esac
done

# Regex for subdirectories and files inside ~/.config to whitelist (keep in sandbox)
DEFAULT_CONFIG_WHITELIST_REGEX="^("
DEFAULT_CONFIG_WHITELIST_REGEX+="gtk.*|git|nvim|gh|dconf|meld"
DEFAULT_CONFIG_WHITELIST_REGEX+=")$"
CONFIG_WHITELIST_REGEX="${CONFIG_WHITELIST_REGEX:-$DEFAULT_CONFIG_WHITELIST_REGEX}"

# Resolve real path of HOME to handle any symlinks robustly
real_home=$(readlink -f "$HOME")

# Build bubblewrap arguments
bwrap_args=(
  --bind / /
  --dev-bind /dev /dev
  --bind "$real_home" "$real_home"
)

hidden_paths=()

# Hide .ssh if it exists by mounting a tmpfs over its real path
if [ -e "$HOME/.ssh" ] || [ -L "$HOME/.ssh" ]; then
  real_ssh=$(readlink -f "$HOME/.ssh")
  bwrap_args+=(--tmpfs "$real_ssh")
  hidden_paths+=("$real_ssh")
fi

# Populate whitelisted entries from ~/.config
if [ -d "$HOME/.config" ]; then
  # Mount a tmpfs over the real path of ~/.config to hide non-whitelisted entries
  real_config=$(readlink -f "$HOME/.config")
  bwrap_args+=(--tmpfs "$real_config")

  # Use nullglob/dotglob to safely iterate over all files, including hidden ones
  shopt -s nullglob dotglob

  for entry in "$HOME/.config"/*; do
    name="${entry##*/}"

    # Skip current and parent directories (just in case)
    if [ "$name" = "." ] || [ "$name" = ".." ]; then
      continue
    fi

    # Bind mount or symlink only whitelisted subdirectories and files matching the regex
    if [[ "$name" =~ $CONFIG_WHITELIST_REGEX ]]; then
      dest="$real_config/$name"
      if [ -L "$entry" ]; then
        target=$(readlink "$entry")
        bwrap_args+=(--symlink "$target" "$dest")
      else
        bwrap_args+=(--bind "$entry" "$dest")
      fi
    else
      hidden_paths+=("$(readlink -f "$entry")")
    fi
  done
fi

# Create a temporary directory for sandbox wrappers
sandy_temp_bin_dir=$(mktemp -d /tmp/sandy-bin.XXXXXX)

# Register cleanup on exit
cleanup() {
  rm -rf "$sandy_temp_bin_dir"
}
trap cleanup EXIT

# Write the git wrapper script if enabled
if [ "$ENABLE_GIT_WRAPPER" = true ]; then
  cat << 'EOF' > "$sandy_temp_bin_dir/git"
#!/usr/bin/env bash
REAL_GIT=$(type -ap git | grep -v "/tmp/sandy-bin" | head -n 1)

if [ -z "$REAL_GIT" ]; then
  echo "Error: git command not found." >&2
  exit 127
fi

# Parse git options to find the correct repository path
git_opts=()
i=1
while [ $i -le $# ]; do
  eval "val=\${$i}"
  case "$val" in
    -C)
      next=$((i + 1))
      eval "path=\${$next}"
      git_opts+=("-C" "$path")
      i=$((i + 2))
      ;;
    --git-dir=*)
      git_opts+=("$val")
      i=$((i + 1))
      ;;
    --work-tree=*)
      git_opts+=("$val")
      i=$((i + 1))
      ;;
    *)
      break
      ;;
  esac
done

if ! REPO_PATH=$("$REAL_GIT" "${git_opts[@]}" rev-parse --show-toplevel 2>/dev/null); then
  exec "$REAL_GIT" "$@"
fi

FOUND_HIDDEN=false
for hidden in $SANDY_HIDDEN_DIRS; do
  if [[ "$hidden" == "$REPO_PATH"/* ]] || [ "$hidden" = "$REPO_PATH" ]; then
    FOUND_HIDDEN=true
    break
  fi
done

if [ "$FOUND_HIDDEN" = false ]; then
  exec "$REAL_GIT" "$@"
fi

TEMP_INDEX="/tmp/sandy-git-index-$(echo -n "$REPO_PATH" | tr '/' '_')"
REAL_INDEX="$REPO_PATH/.git/index"

if [ -f "$REAL_INDEX" ]; then
  if [ ! -f "$TEMP_INDEX" ] || [ "$REAL_INDEX" -nt "$TEMP_INDEX" ]; then
    cp "$REAL_INDEX" "$TEMP_INDEX"
    for hidden in $SANDY_HIDDEN_DIRS; do
      if [[ "$hidden" == "$REPO_PATH"/* ]] || [ "$hidden" = "$REPO_PATH" ]; then
        rel_path="${hidden#$REPO_PATH/}"
        if [ "$hidden" = "$REPO_PATH" ]; then
          rel_path="."
        fi
        "$REAL_GIT" --git-dir="$REPO_PATH/.git" --work-tree="$REPO_PATH" ls-files -z "$rel_path" | \
          GIT_INDEX_FILE="$TEMP_INDEX" xargs -0 -r "$REAL_GIT" --git-dir="$REPO_PATH/.git" --work-tree="$REPO_PATH" update-index --skip-worktree
      fi
    done
  fi
  export GIT_INDEX_FILE="$TEMP_INDEX"
fi

exec "$REAL_GIT" "$@"
EOF
  chmod +x "$sandy_temp_bin_dir/git"
  export SANDY_HIDDEN_DIRS="${hidden_paths[*]:-}"
fi

# Write wrappers for VS Code commands to fail explicitly and protect sandbox security
for cmd in code code-insiders codium; do
  if command -v "$cmd" >/dev/null 2>&1; then
    cat << EOF > "$sandy_temp_bin_dir/$cmd"
#!/usr/bin/env bash
echo "Error: Running $cmd inside the sandy sandbox is disabled to prevent running it without its default sandbox protection." >&2
exit 1
EOF
    chmod +x "$sandy_temp_bin_dir/$cmd"
  fi
done

# Export PATH for wrapper scripts
export PATH="$sandy_temp_bin_dir:$PATH"

# Run bubblewrap
if [ $# -eq 0 ]; then
  bwrap "${bwrap_args[@]}" /bin/bash
elif [[ "$1" == -* ]]; then
  bwrap "${bwrap_args[@]}" /bin/bash "$@"
else
  bwrap "${bwrap_args[@]}" "$@"
fi
